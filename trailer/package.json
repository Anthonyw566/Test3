{
  "name": "distant-frontiers-trailer",
  "private": true,
  "type": "module",
  "description": "A fully procedural trailer for Distant Frontiers: every pixel and every sound is generated by code.",
  "scripts": {
    "build": "node build.mjs",
    "build:gpu": "node build.mjs --gpu",
    "render": "node render.mjs",
    "stills": "node render.mjs --gpu --still 9.2 19 34.5 44.2 49.3 62.9"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/im-fell-english": "^5.0.0",
    "@fontsource/playfair-display": "^5.3.0",
    "playwright": "1.56.1"
  }
}
